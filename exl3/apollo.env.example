# Apollo 2× DGX Spark direct-CX7 topology.
# Copy to .env inside exl3/ and adjust only if your interfaces differ.

PATH=/home/ishilabs/.venvs/qwen38-vllm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HEAD_IP=10.100.120.2
WORKER_IP=10.100.120.1
WORKER_USER=ishilabs
WORKER_HOME=/home/ishilabs
WORKER_SSH=apollo-2
HEAD_CX7_IF=enp1s0f1np1
WORKER_CX7_IF=enp1s0f1np1
HEAD_CX7_IB=rocep1s0f1
WORKER_CX7_IB=rocep1s0f1

MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_FALLBACK=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
HF_HOME=/home/ishilabs/models/hf-exl3
WORKER_CACHE_DIR=/home/ishilabs/models/hf-exl3
IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks@sha256:9bb1557a4234fce63d59599e44d10747eabd742beb337eebf9e7070be8a0fd58

PORT=8889
MASTER_PORT=29521
TP=2
NNODES=2
QUANTIZATION=exl3
SERVED_MODEL_NAME=apollo-glm-5.3-flash
SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=1

MAX_MODEL_LEN=900000
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=1024
GPU_MEM_UTIL=0.88
KV_CACHE_DTYPE=fp8
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1

LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":4,"video":1}'
GLM53_BOOT_SHAPE_WARMUP=1
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=skip
USE_HOST_NCCL=0
NCCL_IB_GID_INDEX=3
NCCL_DEBUG=WARN

# This file contains only a path, never the credential itself. start.sh reads
# the secret and injects it into the head container environment.
VLLM_API_KEY_FILE=/home/ishilabs/glm53-flash-vllm-upstream/.vllm-api-key
READY_TIMEOUT=3600
